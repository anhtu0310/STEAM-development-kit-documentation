# STEAM Live Lab Console: ESP-IDF 5.4.x, ESP32-S3 with octal PSRAM.
#
# The settings marked [VGA] are the stability design described in
# VGA_STABILITY.md. Change them only together with that document.

CONFIG_IDF_TARGET="esp32s3"

# --- Flash and partitions -------------------------------------------------
# 8 MB header + a 4 MB layout: the image boots on an N8R* or N16R* module,
# so the flash-size question in the draft does not block the demo. The OLED
# and the VGA footer show the sizes the chip actually reports.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- PSRAM ----------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
# [VGA] Code and read-only data run from PSRAM, so a flash write (NVS, PHY
# calibration, BLE bonding keys) no longer disables the cache or stalls the
# other core. Without this, every NVS write freezes the refill interrupt.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# Big allocations (HTTP server, Bluedroid, Wi-Fi/lwIP buffers) go to PSRAM so
# internal SRAM stays free for the bounce buffers and DMA.
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y

# --- CPU and caches --------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- RGB LCD (VGA) ---------------------------------------------------------
# [VGA] The refill ISR is in IRAM and touches only DRAM + the PSRAM frame
# buffer, which stays reachable with XIP from PSRAM.
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
# [VGA] Deliberately OFF. In IDF 5.4.x (and 5.5.1) "always restart" never
# resets the bounce-buffer EOF counter, so one lost EOF leaves the driver
# refilling the buffer the DMA is reading: permanent banding/flicker. With
# it off, the driver still restarts at VSYNC after an EOF deficit and resets
# the counter, so a missed refill costs one frame. See VGA_STABILITY.md.
# CONFIG_LCD_RGB_RESTART_IN_VSYNC is not set

# --- Core split [VGA] ------------------------------------------------------
# Core 1 = VGA refill ISR + dashboard renderer only. Every radio, network,
# USB and storage task and interrupt lives on core 0.
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_BT_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_ESP_TIMER_ISR_AFFINITY_CPU0=y

# --- Bluetooth: BLE-only Bluedroid HID host (AB Shutter3) -------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# --- Wi-Fi soft-AP + W5500 Ethernet -----------------------------------------
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# --- USB host (Type-A port; the Type-C USB device port is not used) ---------
CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1024
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# --- Storage ---------------------------------------------------------------
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# --- FreeRTOS ----------------------------------------------------------------
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y


# Console on the CP2102 UART only; the native USB PHY belongs to USB host.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200

# --- Internal SRAM budget ---------------------------------------------------
# Application task stacks are in PSRAM (spawn() in app_state.cpp); these trim
# the stacks that stay internal.
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# With XIP from PSRAM the cache is never disabled, so these no longer need
# IRAM for correctness; moving them out frees internal SRAM for heap. They now
# run from PSRAM through the instruction cache on core 0.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
